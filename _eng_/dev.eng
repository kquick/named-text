dev
 subcmd
   build
     Builds the project
       exec = cabal build named-text
   test
     testcase
       namedTests
         type = EXE
         runner = cabal_test
     testrunner
       cabal_test
         exec = cabal test {TestName}

   update_deps =
      Update all dependencies =
        in dir = {TopDir}
        exec = |
          set -e
          nix run .#depmgr flake_update
          nix run .#depmgr cabal2nix ./nix microlens-src microlens

   update_deps:local =
      Update local development dependencies =
        needs = build:nix-deriv
        in dir = {TopDir}
        exec = |
          set -e
          nix run .#depmgr flake_update kquick
          nix run .#depmgr flake_update galoisinc
          nix run .#depmgr cabal2nix ./nix parameterized-utils-src

   build:nix-deriv
      Builds local (cached) derivation
        in dir = {TopDir}/nix
        exec = nix run nixpkgs#cabal2nix .. > named-text.nix

   nixbuild:old
     Uses nix to build with old GHC versions
       in dir = {TopDir}
       exec =
         nix build --no-link --override-input nixpkgs github:nixos/nixpkgs/25.05 $(
           for X in 810 90 92 ; do
             echo ".#named-text.ghc$X"
           done)
         nix build --no-link $(for X in 94 ; do echo ".#named-text.ghc$X"; done)
   nixbuild:recent
     Uses nix to build with recent GHC versions
       in dir = {TopDir}
       exec = nix build --no-link $(for X in 96 98 ; do echo ".#named-text.ghc$X"; done)
   nixbuild
     Uses nix to build with current GHC versions
       in dir = {TopDir}
       exec = nix build --no-link $(for X in 910 912 914 ; do echo ".#named-text.ghc$X"; done)
   nixbuild:all =
     Uses nix to build with all supported GHC versions =
       in dir = {TopDir}
       needs = nixbuild nixbuild:old nixbuild:recent
       exec = echo All nix builds completed
